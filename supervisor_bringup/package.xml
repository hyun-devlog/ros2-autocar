<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>supervisor_bringup</name>
  <version>0.1.0</version>
  <description>Starts the supervisor with Hiwonder motor inputs routed through safety_gate</description>
  <maintainer email="sohyun309097@gmail.com">Sohyun Park</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>health_monitor</exec_depend>
  <exec_depend>safety_gate</exec_depend>
  <exec_depend>controller</exec_depend>
  <exec_depend>peripherals</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
